# Database Connection String
ConnectionStrings__AppConnection="Server=YOUR_SERVER_IP,1433;Database=YOUR_DB;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;MultipleActiveResultSets=true;"

# Postmark Email Service
PostmarkSettings__ServerToken="YOUR_POSTMARK_SERVER_TOKEN"

# AWS Configuration (S3 Storage)
AwsConfiguration__AWSAccessKey="YOUR_AWS_ACCESS_KEY"
AwsConfiguration__AWSSecretKey="YOUR_AWS_SECRET_KEY"

# KudiSMS Configuration
KudiSms__BaseUrl="https://my.kudisms.net/api"
KudiSms__Token="YOUR_KUDISMS_TOKEN"

# ASP.NET Core Runtime Settings
ASPNETCORE_ENVIRONMENT=Production
ENABLE_HTTPS_REDIRECTION=false
