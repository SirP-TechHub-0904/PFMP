@page
@model RazorWebUI.Areas.ITrainings.Pages.TrainingSettingsPage.AddModel
@{
}

<div class="card card-default">
    <div class="card-header">
        <h3 class="card-title">ADD NEW TRAINING SETTINGS</h3>
    </div>
    <div class="card-body">
        <h3 class="text-uppercase">Training Information</h3>
        <h3 class="card-title">
            @Model.Training.Title ( @Model.Training.StartDate.ToString("ddd dd MMM, yyyy") -
            @Model.Training.EndDate.ToString("ddd dd MMM, yyyy"))
        </h3>
    </div>
    <!-- /.card-header -->
    <div class="card-body">
        <div class="row">
            <div class="col-md-12">
                <form method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="TrainingSetting.TrainingId" value="@Model.Training.Id" />
                    <div class="form-group">
                        <div class="card-header">
                            Template Key::: Kindly add the <b>KEY</b> in the body of the template.
                            <table class="table">
                                <tr>
                                    <td>Key</td>
                                    <td>Meaning</td>
                                </tr>
                                <tr>
                                    <td>{logininformation}</td>
                                    <td>This will show the login details and temporal password with instructions</td>
                                </tr>
                                <tr>
                                    <td>{fullname}</td>
                                    <td>This will show the fullname of the user</td>
                                </tr>
                                <tr>
                                    <td>{surname}</td>
                                    <td>This will show the surname of the user</td>
                                </tr>
                            </table>

                        </div>
                    </div>
                    <div class="form-group">
                        <label asp-for="TrainingSetting.Subject" class="control-label"></label>
                        <input asp-for="TrainingSetting.Subject" class="form-control" />
                        <span asp-validation-for="TrainingSetting.Subject" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="TrainingSetting.Template" class="control-label"></label>
                        <textarea asp-for="TrainingSetting.Template" class="form-control summernote"></textarea>
                        <span asp-validation-for="TrainingSetting.Template" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <input type="submit" value="Add" class="btn btn-primary" />
                        <a asp-page="./Index" class="btn bg-gradient-warning btn-sm" style="float:right;">Back</a>

                    </div>
                </form>
            </div>
        </div>


        <!-- /.row -->
    </div>
    <!-- /.card-body -->
    <div class="card-footer">
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/lga.js"></script>
}
