@page
@model RazorWebUI.Areas.ITrainings.Pages.TrainingSettingsPage.IndexModel
@{
}
<div class="card">
    <div class="card-header">
        <h3 class="card-title">TRAINING SETTINGSS</h3>

        @if (User.IsInRole("AdminEditor") || Model.Training.TrainingStatus != Domain.Models.EnumStatus.TrainingStatus.Completed)
        {
            if (Model.Datas.Count() == 0)
            {
                <a asp-page="./Add" asp-route-id="@Model.Training.Id" class="btn bg-gradient-warning btn-sm" style="float:right;">New TrainingSetting</a>

            }
        }

        <a asp-page="/TrainingImagePage/Index" asp-route-id="@Model.Training.Id" class="btn bg-gradient-warning btn-sm" style="float:right;">Manage Templete Image</a>

    </div>
    <div class="card-body">
        <h3 class="text-uppercase">Training Information</h3>
        <h3 class="card-title">
            @Model.Training.Title ( @Model.Training.StartDate.ToString("ddd dd MMM, yyyy") -
            @Model.Training.EndDate.ToString("ddd dd MMM, yyyy"))
        </h3>
    </div>
    <!-- /.card-header -->
    <div class="">

        @foreach (var item in Model.Datas)
        {
            <div class="card-header">
                Template Key::: Kindly add the <b>KEY</b> in the body of the template.
                <table class="table">
                    <tr>
                        <th>Key</th>
                        <td>Meaning</td>
                    </tr>
                    <tr>
                        <th>{logininformation}</th>
                        <td>This will show the login details and temporal password with instructions</td>
                    </tr>
                    <tr>
                        <th>{fullname}</th>
                        <td>This will show the fullname of the user</td>
                    </tr>
                    <tr>
                        <th>{surname}</th>
                        <td>This will show the surname of the user</td>
                    </tr>
                </table> 

            </div>
            <div class="card-body">
                <div>
                    <h4>@item.Subject</h4>
                </div>
                <div>
                    @Html.Raw(item.Template)
                </div>
                <a asp-page="./Update" asp-route-id="@item.Id" class="btn btn-primary">
                    Update Template
                </a>
            </div>
        }

    </div>
</div>
