@page
@model RazorWebUI.Areas.User.Pages.UserGroupPage.DetailsModel
@{
}
<div class="card">
    <div class="card-header">
        <h3 class="card-title">USER CATEGORY DETAILS</h3>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Title</dt>
            <dd class="col-sm-9">@Model.UserCategory.Title</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@Model.UserCategory.Description</dd>
        </dl>
    </div>
    <div class="card-footer">
        <a asp-page="Edit" asp-route-id="@Model.UserCategory.Id" class="btn btn-info">Edit</a>
        <a asp-page="Index" class="btn btn-secondary">Back</a>
    </div>
</div>


<div class="card mb-4">
    <div class="card-header">
        <h4 class="card-title">Upload Users via Excel</h4>
    </div>
    <div class="card-body">
        <form method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label>Select Excel File</label>
                <input type="file" name="ExcelFile" class="form-control" required />
            </div>

            <button type="submit" class="btn btn-primary">Upload</button>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h4 class="card-title">Group Members</h4>
    </div>
    <div class="card-body table-responsive"> 
        <table id="example1" class="table table-bordered table-striped">

            <thead>
                <tr>
                    <th>S/N</th>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>ColumnOne</th>
                    <th>ColumnTwo</th>
                    <th>ColumnThree</th>
                    <th>ColumnFour</th>
                </tr>
            </thead>
            @{
                int sn = 0;
            }
            <tbody>
                @foreach (var item in Model.UserList)
                {
                    <tr>

                        <td>
                            @{
                                sn++;
                            }
                            @sn
                        </td>
                        <td>@item.User.FullnameX</td>
                        <td>@item.User.Email</td>
                        <td>@item.User.PhoneNumber</td>
                        <td>@item.ColumnOne</td>
                        <td>@item.ColumnTwo</td>
                        <td>@item.ColumnThree</td>
                        <td>@item.ColumnFour</td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
        <div class="card-footer">
            <a asp-page="Edit" asp-route-id="@Model.UserCategory.Id" class="btn btn-info">Edit Category</a>
            <a asp-page="Index" class="btn btn-secondary">Back</a>
        </div>
    </div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}