@page
@model RazorWebUI.Areas.User.Pages.UserGroupPage.DeleteModel
@{
}
<div class="card">
    <div class="card-header">
        <h3 class="card-title">DELETE USER CATEGORY</h3>
    </div>
    <div class="card-body">
        <p>Are you sure you want to delete this?</p>
        <dl class="row">
            <dt class="col-sm-3">Title</dt>
            <dd class="col-sm-9">@Model.UserCategory.Title</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@Model.UserCategory.Description</dd>
        </dl>

        <form method="post">
            <input type="hidden" asp-for="UserCategory.Id" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-page="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>