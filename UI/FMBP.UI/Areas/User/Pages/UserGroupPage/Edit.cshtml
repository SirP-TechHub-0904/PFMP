@page
@model FMBP.UI.Areas.User.Pages.UserGroupPage.EditModel
@{
}
<div class="card card-default">
    <div class="card-header">
        <h3 class="card-title">EDIT USER CATEGORY</h3>
    </div>
    <div class="card-body">
        <form method="post">
            <input type="hidden" name="Id" value="@Model.Id" />
            <div class="form-group">
                <label asp-for="UserCategory.Title"></label>
                <input asp-for="UserCategory.Title" class="form-control" />
                <span asp-validation-for="UserCategory.Title" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="UserCategory.Description"></label>
                <input asp-for="UserCategory.Description" class="form-control" />
                <span asp-validation-for="UserCategory.Description" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Update</button>
            <a asp-page="Index" class="btn bg-gradient-warning btn-sm" style="float:right;">Back</a>
        </form>
    </div>
</div>