@page
@model FMBP.UI.Areas.ITrainings.Pages.Account.EvaluationModel
@{
}
<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    EVALUTION
                </h3>
                <a asp-page="./Info" asp-route-id="@Model.Training.Id" class="btn bg-gradient-warning btn-sm" style="float:right;">Back</a>

            </div>
            <div class="card-body">
                <h3 class="text-uppercase">Training Information</h3>
                <h3 class="card-title">
                    @Model.Training.Title ( @Model.Training.StartDate.ToString("ddd dd MMM, yyyy") -
                    @Model.Training.EndDate.ToString("ddd dd MMM, yyyy"))
                </h3>
            </div>

            <hr />
            <div class="card-body">
                <h5 class="text-uppercase">INSTRUCTIONS:</h5>
                <h6 class="">

                    Attempt All Questions
                </h6>
            </div>

            <hr />
            <!-- /.card-header -->
            <form method="post">
                <div class="card-body">

                    <input asp-for="Exampath" type="hidden" />
                    <input asp-for="DialyId" type="hidden" value="@Model.DialyActivity.Id" />
                    <input asp-for="TrainingId" type="hidden" value="@Model.Training.Id" />
                    <div class="row">
                        <div class="col-md-12">
                            @{ int sn = 0;}
                            @foreach (var item in Model.Datas)
                            {
                                <div style=" box-shadow: 0px 2px 2px 0px rgb(50 50 50 / 83%);padding:10px;margin-bottom:5px;">
                                    <div class="row">
                                        <div class="col-md-6">

                                            <h5>
                                                <b style="margin-right:15px;font-size:20px;">
                                                    @{ sn++;}
                                                    @sn
                                                </b>@item.Question
                                            </h5>
                                        </div>
                                        <div class="col-md-6">



                                            @if (item.EvaluationAnswerType == Domain.Models.EnumStatus.EvaluationAnswerType.Options)
                                            {
                                                @foreach (var list in item.DialyEvaluationQuestionOptions)
                                                {
                                                    <div class="form-check form-check-inline">
                                                        <input class="form-check-input" type="radio" name="answer_@item.Id" id="true_@sn" value="@list.Option" required>
                                                        <label class="form-check-label" for="true_@sn">@list.Option</label>
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <input class="form-control" type="text" name="answer_@item.Id" required>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }


                        </div>
                    </div>


                    <!-- /.row -->
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary">Submit</button>
                    <a href="javascript:history.back()" class="btn bg-gradient-warning btn-sm">Back</a>

                </div>
            </form>
        </div>
    </div>
</div>