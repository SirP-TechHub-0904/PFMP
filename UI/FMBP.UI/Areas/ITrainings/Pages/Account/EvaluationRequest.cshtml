@page
@model FMBP.UI.Areas.ITrainings.Pages.Account.EvaluationRequestModel
@{
}
<div class="row">
    <div class="col-lg-12">
        @if (Model.TrainingsWithTodayActivity != null && Model.TrainingsWithTodayActivity.Any())
        {
            foreach (var training in Model.TrainingsWithTodayActivity)
            {
                <div class="card mb-4">
                    <div class="card-header bg-dark text-white">
                        <h5 class="mb-0">@training.TrainingTitle</h5>
                        <small>@training.TrainingDate | @training.TrainingState - @training.TrainingLGA</small>
                    </div>

                    <div class="card-body">

                        <!-- Pre Test -->
                        <div class="card mb-3 bg-primary text-white">
                            <div class="card-body">
                                <h6 class="fw-bold">Pre Test</h6>
                                @if (training.EnablePreTest == true)
                                {
                                    <a class="btn btn-light btn-sm me-2"
                                       asp-page="./Assessment" asp-route-xty="0" asp-route-tid="@training.TrainingId">
                                        Start Pre Test
                                    </a>
                                    <a class="btn btn-outline-light btn-sm"
                                       asp-page="./Result" asp-route-tid="@training.TrainingId" asp-route-xty="0">
                                        View Result
                                    </a>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Not Activated</span>
                                }
                            </div>
                        </div>

                        <!-- Daily Evaluation -->
                        <div class="card mb-3 bg-success text-white">
                            <div class="card-body">
                                <h6 class="fw-bold">Daily Evaluation</h6>
                                @if (training.DailyActivityDto != null && training.DailyActivityDto.Any())
                                {
                                    foreach (var activity in training.DailyActivityDto)
                                    {
                                        <p><strong>@activity.Title</strong> (@activity.Date.ToString("ddd dd MMM, yyyy"))</p>
                                        <a asp-page="./Evaluation"
                                           asp-route-id="@activity.Id"
                                           class="btn btn-light btn-sm mb-2">
                                            Start Evaluation
                                        </a>
                                    }
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">No Evaluation Available</span>
                                }
                            </div>
                        </div>

                        <!-- Post Test -->
                        <div class="card bg-info text-white">
                            <div class="card-body">
                                <h6 class="fw-bold">Post Test</h6>
                                @if (training.EnablePostTest == true)
                                {
                                    var currentTime = DateTime.UtcNow.AddHours(1).TimeOfDay;
                                    var postTestStartTime = training.PostTestStartTime;
                                    var isPostTestStartTimeReached = currentTime >= postTestStartTime;

                                    if (isPostTestStartTimeReached)
                                    {
                                        <a class="btn btn-light btn-sm me-2"
                                           asp-page="./Assessment" asp-route-xty="2" asp-route-tid="@training.TrainingId">
                                            Start Post Test
                                        </a>
                                        <a class="btn btn-outline-light btn-sm"
                                           asp-page="./Result" asp-route-tid="@training.TrainingId" asp-route-xty="2">
                                            View Result
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Available after @postTestStartTime</span>
                                    }
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Not Activated</span>
                                }
                            </div>
                        </div>

                    </div>
                </div>
            }
        }
        else
        {
            <p class="text-muted">No trainings found.</p>
        }
    </div>
</div>

